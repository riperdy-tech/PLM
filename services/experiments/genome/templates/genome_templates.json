        "organic_electronic": "focus_organic_electronic",
        "piano_synth_concentration": "focus_piano_synth_concentration"
      }
    }
  },
  "brief_genre_inference": {
    "basis": "Owner decision 2026-10-31: a P1 arm whose brief names no genre is produced, not refused. P3 takes the arm's first use case listed here (with none, the open list), picks a genre from it by a stable hash of the directive id so repeated arms spread across genres, and records the inference on the experiment. ADR-0044 (2026-11-01): the focus use cases infer only focus_electronic.",
    "by_use_case": {
      "sleep": ["ambient", "lofi", "jazz"],
      "study_focus": ["focus_electronic"],
      "late_night_drive": ["synthwave", "city_pop", "rnb"],
      "relax": ["lofi", "jazz", "ambient"],
      "focus": ["focus_electronic"]
    },
    "open_brief": ["focus_electronic", "lofi", "ambient", "jazz", "synthwave", "city_pop", "rnb", "house"]
  },
