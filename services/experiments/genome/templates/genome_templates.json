  "playlist_duration_policy": {
    "default_bucket": "90_120m",
    "basis": "Owner decision 2026-10-15 (ADR-0036), amended 2026-11-01 (ADR-0044 decision 3): a playlist video is 90-120 min, one deep-work block. The default bucket's range is the policy range: a directive that names no duration_bucket gets it, and every template's and directive bucket's range must lie inside it (playlist_duration_outside_policy otherwise)."
  },
  "playlist_duration_buckets": {
    "10_45m": {"min_seconds": 600, "max_seconds": 2700, "target_seconds": 1650},
    "45_75m": {"min_seconds": 2700, "max_seconds": 4500, "target_seconds": 3600},
    "90_120m": {"min_seconds": 5400, "max_seconds": 7200, "target_seconds": 6300}
  },
