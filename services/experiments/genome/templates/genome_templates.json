  "subgenre_templates": {
    "basis": "ADR-0044 amendment 2026-11-01 decision 1: the brand's nine sub-styles. A brief whose subgenre is listed under its genre gets that sub-style's template; a brief with no subgenre, or one not listed, gets the genre's template (recorded on the experiment).",
    "by_genre": {
      "focus_electronic": {
        "future_garage_focus": "focus_future_garage",
        "soft_cyber_electronica": "focus_soft_cyber_electronica",
        "minimal_pulse": "focus_minimal_pulse",
