# Copy to .env for local development; never commit .env. docker compose reads it.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://plm:change-me@localhost:5432/plm
MINIO_ROOT_USER=plm
MINIO_ROOT_PASSWORD=change-me
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=plm-media
TEMPORAL_HOST=localhost:7233

# Compose services reach each other by service name (postgres:5432, minio:9000,
# temporal:7233). The localhost values above are for tools running on the host.

# External provider secrets are all unset on purpose - mock-first development
# needs none of them. Fill in real values only in .env when wiring a provider.
# YOUTUBE_API_KEY=
# YOUTUBE_OAUTH_CLIENT_ID=
# YOUTUBE_OAUTH_CLIENT_SECRET=
# MUSIC_PROVIDER_API_KEY=
# DISTRIBUTOR_API_KEY=
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
