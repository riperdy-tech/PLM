# Copy to .env for local development; never commit .env. docker compose reads it.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://plm:change-me@127.0.0.1:5432/plm
MINIO_ROOT_USER=plm
MINIO_ROOT_PASSWORD=change-me
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_BUCKET=plm-media
TEMPORAL_HOST=127.0.0.1:7233

# Compose services reach each other by service name (postgres:5432, minio:9000,
# temporal:7233). The 127.0.0.1 values above are for tools running on the host: compose
# publishes ports on IPv4 loopback only, and "localhost" may resolve to IPv6 ::1 first,
# which costs a full connect timeout per connection before falling back.

# External provider secrets are all unset on purpose - mock-first development
# needs none of them. Fill in real values only in .env when wiring a provider.
# YOUTUBE_API_KEY=
# YOUTUBE_OAUTH_CLIENT_ID=
# YOUTUBE_OAUTH_CLIENT_SECRET=
# MUSIC_PROVIDER_API_KEY=
# DISTRIBUTOR_API_KEY=
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# Internal service token for phase APIs and the pipeline worker (R15). A development
# placeholder like the passwords above: change it for any shared machine. Absent, every
# phase API answers 503 blocked_pending_credentials. docker compose passes it to every
# api-* container and the pipeline-worker.
PLM_SERVICE_TOKEN=change-me-dev-service-token

# Provider mode and execution policy (plm_platform.execution). Both default to the
# safe value when unset, so leave them out for mock-first development:
#   PLM_PROVIDER_MODE__<INTEGRATION>        mock (default) | real
#       e.g. PLM_PROVIDER_MODE__YOUTUBE selects the YouTube implementation.
#   PLM_EXECUTION_POLICY__<CAPABILITY>      read_only | dry_run (default) | shadow | live
#       e.g. PLM_EXECUTION_POLICY__YOUTUBE_UPLOAD governs capability youtube.upload.
# "live" alone never permits a write: each live write also needs an operator
# authorization record, a budget reservation and an idempotency key.
#       e.g. PLM_PROVIDER_MODE__MUSIC set to real selects Suno in P4 (still guarded).
#   PLM_WRITE_AUTHORIZATIONS_FILE   JSON list of the owner's time-limited grants:
#       [{"capability": "music.generate", "granted_by": "owner",
#         "granted_at": "<ISO 8601 with offset>", "expires_at": "<ISO 8601 with offset>",
#         "reference": "<decision id>"}]   Unset: no grants, every live write refused.
#   PLM_SUNO_MANUAL_INBOX   folder for songs the owner makes on suno.com (D10). Set, with
#       the music provider mode real, P4 imports WAV downloads from it instead of calling
#       Suno, writes <track>.prompts.txt there and waits for the files (capability
#       music.import: live policy, a grant and a ledger rate of 0).
#   PLM_SUNO_PLAN_TIER, PLM_SUNO_ACCOUNT_REF   the owner's declared paid tier (pro or
#       premier) and Suno account; both are needed for commercial rights on file.
#   PLM_SUNO_MODEL_VERSION   the Suno model the owner uses (e.g. v4.5), for P28.
#   PLM_FLOW_MUSIC_MANUAL_INBOX   folder for songs the owner makes in Google Flow Music
#       (Lyria 3.5; D10 as changed 2026-10-31). Takes precedence over the Suno inbox;
#       works the same way (prompt sheets, WAV downloads, capability music.import).
#   PLM_FLOW_MUSIC_PLAN_TIER, PLM_FLOW_MUSIC_ACCOUNT_REF   the owner's declared plan
#       (google_ai_pro) and Google account; both are needed for commercial rights on file.
#   PLM_FLOW_MUSIC_MODEL_VERSION   the Flow Music instrument the owner uses (lyria-3.5).
#   PLM_EXPERIMENTS_MANUAL_SUPPLY   true: P3 designs the control package only and one
#       candidate per track, so a manual-Suno run needs one song per track (D10).

# R5 pipeline configuration. docker compose sets these for the containers (development
# values from the bind-mounted repo); add them to .env only to override, or for a worker
# or API run on the host (they are read from the environment, then .env).
#   PLM_BUDGET_LEDGER_CURRENCY   ledger currency (compose default USD). The phases' write
#       guards reserve in it; the pipeline worker reads the run's write costs from it.
#       Unset: live writes are refused and the outcome step refuses (never free spend).
#   PLM_PIPELINE_CONFIG_FILE     JSON: P7 channel + operating mode, P8 release metadata,
#       FX rates recorded in P9, P2 learning-cycle parameters (config/dev/pipeline.json;
#       see plm_platform/pipeline/config.py). A missing section makes its step refuse.
#   PLM_MOCK_OUTCOMES_FILE       JSON: the deterministic mock outcome model behind P7's
#       mock YouTube Analytics and P8's mock statements (config/dev/mock_outcomes.json;
#       see plm_platform/testing/mock_outcomes.py). Unset: those sources refuse.
#   PLM_MEDIA_RENDER_PROFILE     P6's render profile when a request names none (compose
#       default preview_360p_v1 for the local stack; unset: yt_longform_1080p_v1).
#       An undeclared profile fails P6 at boot.
