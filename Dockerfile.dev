# Pinned by digest; to upgrade: docker pull python:3.12-slim, then take the new RepoDigest.
FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# FFmpeg 7 is pinned for the media phases; fail the build if apt ships another major.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && ffmpeg -version | grep -Eq "^ffmpeg version 7\." \
    && rm -rf /var/lib/apt/lists/*

# libsndfile for audio I/O; build-essential for native wheels.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libsndfile1 build-essential \
    && rm -rf /var/lib/apt/lists/*

# pg_dump 16 (the server's major) from the PostgreSQL apt repository: P6 writes a
# database dump with every archive run (services/media_factory/archive.py).
RUN apt-get update \
    && apt-get install -y --no-install-recommends postgresql-common ca-certificates \
    && /usr/share/postgresql-common/pgdg/apt.postgresql.org.sh -y \
    && apt-get install -y --no-install-recommends postgresql-client-16 \
    && pg_dump --version | grep -Eq " 16\." \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Editable install; the compose worker bind-mounts the repo over /app at runtime.
# The same pinned dependency set as CI and the host venv (constraints.txt).
COPY pyproject.toml README.md constraints.txt ./
COPY packages/ packages/
COPY services/ services/
RUN pip install -c constraints.txt -e ".[dev]"

# W0.7 replaces this with the real worker entry point (python -m plm_platform.worker).
CMD ["sleep", "infinity"]
